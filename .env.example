# Server
PORT=3000
NODE_ENV=development

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/realchat_db

# JWT
JWT_ACCESS_SECRET=your_access_secret_key_here
JWT_REFRESH_SECRET=your_refresh_secret_key_here
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Frontend
FRONTEND_URL=http://localhost:5173

# CORS
CORS_ORIGIN=http://localhost:5173

# SMTP
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# Firebase Cloud Messaging (optional). JSON string dari file service-account (project settings -> Service accounts),
# atau path absolut ke file JSON tsb. Kosongkan jika push notification belum dipakai.
FIREBASE_SERVICE_ACCOUNT=
# Simulasi latensi FCM di mode non-production (ms), hanya untuk verifikasi bahwa ACK tidak menunggu push.
PUSH_DRY_RUN_DELAY_MS=0

# Upload
UPLOAD_DIR=uploads
MAX_FILE_SIZE=5242880

# Number of proxy hops in front of the app (0 when directly exposed; 1 behind Nginx/a load balancer)
TRUST_PROXY=0

# Socket rate limits for message:send (per user)
MESSAGE_RATE_PER_SECOND=20
MESSAGE_RATE_PER_MINUTE=120

# Min interval between typing:start broadcasts (ms) per user:conversation
TYPING_THROTTLE_MS=500

# Min interval between message:seen processing (ms) per user:conversation
SEEN_THROTTLE_MS=500

# Min interval between message:pin / message:unpin processing (ms) per user
PIN_THROTTLE_MS=500

# Min interval between message:reaction:add / message:reaction:remove processing (ms) per user:message
REACTION_THROTTLE_MS=500

# Min interval between message:star / message:unstar processing (ms) per user
STAR_THROTTLE_MS=500